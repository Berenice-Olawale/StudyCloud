# Flask/JWT secrets: replace before deployment
SECRET_KEY=replace-with-long-random-secret
JWT_SECRET_KEY=replace-with-long-random-jwt-secret

# Local development: omit DATABASE_URL to use SQLite
# AWS RDS MySQL example (URL-encode password characters):
# DATABASE_URL=mysql+pymysql://studycloud_user:password@rds-endpoint:3306/studycloud

AWS_REGION=eu-west-1
S3_BUCKET=studycloud-materials-2026-chika
# If unset, materials are stored locally in backend/uploads.

